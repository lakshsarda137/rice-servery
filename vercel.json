{
  "version": 2,
  "builds": [
    {
      "src": "servery_finder_web.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "servery_finder_web.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/log-menus",
      "schedule": "0 13 * * *"
    }
  ],
  "env": {
    "ENV": "production"
  }
}
