# Copy to .env for local runs. On Vercel, set the same names under
# Project -> Settings -> Environment Variables (the .env file is not deployed).

# Supabase -> Project Settings -> Data API -> Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...),
# or the legacy "service_role" key. Server-only: never put it in frontend code.
SUPABASE_SECRET_KEY=

# Any long random string. Vercel's cron sends it; other callers of /api/cron/log-menus get a 401.
CRON_SECRET=
